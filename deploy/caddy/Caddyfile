{
	admin off
}

gantt-ai-planner.duckdns.org {
	# Explicit type list instead of the default one: the default matches `text/*`, which
	# includes text/event-stream, and compressing SSE (chat stream, /api/events) can hold
	# events back in the encoder. Caddy response matchers have no `not`, so list what to
	# compress rather than what to skip.
	encode {
		gzip
		zstd
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	request_body {
		max_size 5MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# planner-app = the app's alias on the internal `planner-proxy` network, which only
	# Caddy and the app share (deploy/compose.prod.yml, deploy/caddy/compose.yml).
	reverse_proxy planner-app:8000 {
		flush_interval -1
	}
}
