#!/usr/bin/env bash
# planner-deploy-wrapper
#
# Forced command for the 'deploy' SSH user (see authorized_keys entry
# below). SSH sets SSH_ORIGINAL_COMMAND to whatever the client asked to
# run; this wrapper accepts exactly one token that looks like a
# digest-pinned image reference and nothing else, then execs
# `sudo planner-deploy <ref>`. Any other input (extra tokens, shell
# metacharacters, empty input, a bare tag, bad shape) is rejected without
# ever touching sudo.
#
# The only accepted shape is `sha-<7..40 hex>@sha256:<64 hex>` - what CD
# sends. Tags are mutable in GHCR; the digest pins the exact image that CI
# scanned and pushed, so bare `sha-<hex>` tags are refused for manual
# deploys and rollbacks too (the digest: `docker buildx imagetools inspect
# <image>:sha-<hex>`).
#
# authorized_keys line for the CI deploy key:
#   restrict,command="/usr/local/bin/planner-deploy-wrapper" ssh-ed25519 AAAA... gha-gantt-planner
set -euo pipefail

TAG_RE='^sha-[0-9a-f]{7,40}@sha256:[0-9a-f]{64}$'
PLANNER_DEPLOY_BIN=/usr/local/bin/planner-deploy

# Intentionally unquoted: this is the only word-splitting step, and it is
# what turns "exactly one token" into a real argument count check below.
# `set -f` (noglob) first so a command containing a glob character (e.g. a
# tag like "sha-*" or "sha-abc[123]") is word-split but never expanded
# against files in the CWD.
set -f
# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-}

if [ "$#" -ne 1 ]; then
    echo "planner-deploy-wrapper: expected exactly one argument (sha-<commit>@sha256:<digest>), got: ${SSH_ORIGINAL_COMMAND:-<empty>}" >&2
    exit 1
fi

tag="$1"

if ! [[ "$tag" =~ $TAG_RE ]]; then
    echo "planner-deploy-wrapper: rejected '$tag' (must match $TAG_RE; bare tags are mutable and refused)" >&2
    exit 1
fi

exec sudo "$PLANNER_DEPLOY_BIN" "$tag"
